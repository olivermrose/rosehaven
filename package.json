{
	"name": "rosehaven",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev --host",
		"build": "vp build",
		"preview": "vp preview",
		"sync": "svelte-kit sync",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp lint && vp fmt --check",
		"lint:fix": "vp lint --fix && vp fmt",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/svelte": "^1.1.5",
		"@tanstack/svelte-table": "9.2.8",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-text-align": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"chroma-js": "^3.2.0",
		"dayjs": "^1.11.23",
		"drizzle-orm": "1.0.0-rc.4",
		"lenis": "^1.3.26",
		"mode-watcher": "^1.1.0",
		"motion-sv": "^0.1.13",
		"node-html-markdown": "^2.0.0",
		"pg": "^8.23.1",
		"runed": "^0.37.1",
		"shaders": "^4.0.4",
		"takumi-js": "^2.14.0",
		"tegaki": "^1.1.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261011.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/chroma-js": "^3.1.2",
		"@types/node": "^26.6.5",
		"@types/three": "^0.186.0",
		"drizzle-kit": "1.0.0-rc.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
